# Server configuration
PORT=3001

# FastAPI service URL
FASTAPI_URL=http://localhost:8000

# Database configuration (Cloud Database - Neon/Supabase/Railway)
# For cloud databases, set DB_SSL=true
DB_HOST=your-project.neon.tech
DB_PORT=5432
DB_NAME=esmart_agency
DB_USER=your_username
DB_PASSWORD=your_password
DB_SSL=true

# MongoDB (optional - for TrendData model)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/esmart_agency

# API Keys
DEEPSEEK_API_KEY=your_api_key_here 